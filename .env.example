# MongoDB Learning Platform - Environment Configuration
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_NAME="MongoDB Learning Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# MongoDB Connection (for application data - users, saved queries, etc.)
MONGODB_URI="mongodb://localhost:27017/mongodb_learning_platform"
MONGODB_DATABASE="mongodb_learning_platform"

# MongoDB Atlas (optional - for cloud connections)
# MONGODB_ATLAS_URI="mongodb+srv://username:password@cluster.mongodb.net/database"
# MONGODB_ATLAS_DATABASE="your_database"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Encryption for stored connection strings
ENCRYPTION_KEY="your-32-char-encryption-key-here"
ENCRYPTION_IV="your-16-char-iv-here"

# Session
SESSION_PASSWORD="your-session-password-min-32-chars"
SESSION_COOKIE_NAME="mdb-learning-session"

# Email (for password reset, notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@yourdomain.com"

# Sandbox MongoDB (for isolated learning environment)
SANDBOX_MONGODB_URI="mongodb://localhost:27017/mongodb_sandbox"
SANDBOX_MONGODB_DATABASE="mongodb_sandbox"

# Feature Flags
NEXT_PUBLIC_ENABLE_SANDBOX="true"
NEXT_PUBLIC_ENABLE_ATLAS="true"
NEXT_PUBLIC_ENABLE_DATA_ENGINEERING="true"
NEXT_PUBLIC_ENABLE_MONITORING="true"

# Logging
LOG_LEVEL="debug"
LOG_PRETTY="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# File Upload
MAX_FILE_SIZE_MB="50"
UPLOAD_DIR="./uploads"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Redis (for caching, sessions - optional)
REDIS_URL="redis://localhost:6379"